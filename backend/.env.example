# ===== Server =====
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Database (PostgreSQL) =====
# Với embedded postgres dev (npm run db:dev) dùng chuỗi bên dưới.
# Với PostgreSQL cài sẵn, sửa user/password/host/port cho đúng.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beacondfound?schema=public"

# ===== JWT =====
JWT_SECRET=beacondfound_super_secret_change_me
JWT_EXPIRES_IN=7d

# ===== Cloudinary (để trống sẽ dùng mock local upload) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Google Vision API (để trống sẽ dùng mock suggest tags) =====
GOOGLE_VISION_API_KEY=

# ===== Firebase Cloud Messaging (để trống sẽ dùng mock notification) =====
FCM_SERVER_KEY=
