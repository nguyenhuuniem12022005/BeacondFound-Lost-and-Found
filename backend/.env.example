# ===== Server =====
PORT=5000
CLIENT_URL=http://localhost:5173

# ===== Database (PostgreSQL) =====
# Chọn 1 trong 3 cách (chỉ giữ 1 dòng DATABASE_URL phù hợp):
#
# A) Docker (khuyên dùng): docker compose up -d ở thư mục gốc project
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beacondfound?schema=public"
#
# B) Embedded dev (npm run db:dev) — port 5433
# DATABASE_URL="postgresql://postgres:postgres@localhost:5433/beacondfound?schema=public"
#
# C) PostgreSQL cloud (Neon/Supabase...) — dán connection string họ cấp
# DATABASE_URL="postgresql://user:pass@host:5432/beacondfound?sslmode=require"

# ===== JWT =====
JWT_SECRET=beacondfound_super_secret_change_me
JWT_EXPIRES_IN=7d

# ===== Cloudinary (để trống sẽ dùng mock local upload) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Google Vision API (để trống sẽ dùng mock suggest tags) =====
GOOGLE_VISION_API_KEY=

# ===== Firebase Cloud Messaging (để trống sẽ dùng mock notification) =====
FCM_SERVER_KEY=
